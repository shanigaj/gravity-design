rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contact form: any visitor may SUBMIT a message,
    // but only a signed-in admin can read / manage them.
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Website content (siteImages, gallery, blogPosts, ...):
    // public read so the site displays; only signed-in admin can write.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
